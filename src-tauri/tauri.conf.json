{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "dot md",
  "version": "1.0.0",
  "identifier": "com.dotmd.app",
  "build": {
    "frontendDist": "../",
    "devUrl": "http://localhost:3456"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self' 'unsafe-inline' 'unsafe-eval' data: blob: https:; img-src 'self' data: https: blob:;"
    },
    "windows": [
      {
        "label": "main",
        "title": "dot md",
        "width": 1280,
        "height": 840,
        "minWidth": 800,
        "minHeight": 500,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "theme": "Dark"
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "../favicon.ico",
      "../favicon.svg"
    ],
    "fileAssociations": [
      {
        "ext": ["md", "markdown", "mdown"],
        "name": "Markdown Document",
        "description": "Publication-grade Markdown document",
        "mimeType": "text/markdown",
        "role": "Editor"
      }
    ],
    "windows": {
      "wix": {
        "language": "en-US"
      }
    },
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "10.13"
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0 | libwebkit2gtk-4.0-37"]
      }
    }
  }
}
